MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2049400544}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b16ea9402a67f9e4f964ac1d24753db0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SpecialNPC
  dialogueLines:
  - Hey there, stranger. Did you hear about the slime outbreak?
  - They've been coming from the forest right near Greenwood...
  - No one knows how they got here, but we can't leave because of them.
  - Maybe if you're brave enough, you can try doing something about them.
  - Just... Be careful, will ya? We don't want anyone else getting hurt out there.
  - ...
  portrait: {fileID: 1136184288765050124, guid: aa8710ef7a9076849874a1f9a7b1f50d, type: 3}
  triggersEvent: 1
  eventMessage: Slime Extermination
  advanceActionRef: {fileID: 0}
